# VirtualPhone Environment Configuration

# eUICC EID (32 hex digits)
EUICC_EID=89001012012341234000000000000001

# SM-DP+ server for RSP profile downloads (leave empty to disable)
RSP_SERVER=

# IMS domain (auto-derived from MCC/MNC if empty)
IMS_DOMAIN=ims.mnc001.mcc001.3gppnetwork.org

# P-CSCF proxy address
# When using the IMS core (docker compose --profile ims), this points to the local P-CSCF
# Leave empty for auto-discovery or VoWiFi P-CSCF
IMS_PROXY=172.28.0.41

# ePDG address for VoWiFi (leave empty to disable VoWiFi)
# When using VoWiFi profile (docker compose --profile vowifi), set to local ePDG: 172.28.0.45
VOWIFI_EPDG=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API key for management API authentication (leave empty for open access)
VPHONE_API_KEY=

# Host port for management API (default: 19000)
VPHONE_API_PORT=19000

# ---- IMS Core Settings (used by docker compose --profile ims) ----

# MongoDB host for Open5GS subscriber database
MONGO_HOST=mongodb
MONGO_PORT=27017
