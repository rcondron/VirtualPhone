# VirtualPhone Environment Configuration

# eUICC EID (32 hex digits)
EUICC_EID=89001012012341234000000000000001

# SM-DP+ server for RSP profile downloads (leave empty to disable)
RSP_SERVER=

# IMS domain (auto-derived from MCC/MNC if empty)
IMS_DOMAIN=

# P-CSCF proxy address (leave empty for auto-discovery)
IMS_PROXY=

# ePDG address for VoWiFi (leave empty to disable VoWiFi)
VOWIFI_EPDG=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API key for management API authentication (leave empty for open access)
VPHONE_API_KEY=

# Host port for management API (default: 19000)
VPHONE_API_PORT=19000
